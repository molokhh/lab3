#include <stdio.h>

// Константа для перевода: 1 килограмм = 2.20462262 фунта
#define KG_TO_LB 2.20462262
// В одном фунте 16 унций
#define LB_TO_OZ 16.0

int main() {
    double kg;
    
    printf("Введите вес в килограммах: ");
    // Проверка корректности ввода числового значения
    if (scanf("%lf", &kg) != 1) {
        printf("Ошибка: введено некорректное число.\n");
        return 1;
    }
    
    if (kg < 0) {
        printf("Ошибка: вес не может быть отрицательным.\n");
        return 1;
    }

    // Полный вес только в фунтах
    double total_lbs = kg * KG_TO_LB;

    // Выделяем целое количество фунтов
    int lbs = (int)total_lbs;

    // Оставшуюся дробную часть фунта переводим в унции
    double ounces = (total_lbs - lbs) * LB_TO_OZ;

    // Вывод результата (округляем унции до 2 знаков после запятой)
    printf("%.2f кг = %d фт %u.2f унц\n", kg, lbs, ounces);
    printf("Детализация: %.2f кг — это %d целых фунтов и %.2f унций.\n", kg, lbs, ounces);

    return 0;
}
